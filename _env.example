PORT=8787
AFC_DATA_DIR=/app/data
# Anzahl vertrauenswürdiger Proxys vor dem Server (für die IP-Erkennung des Rate-Limits). Railway/Render: 1
AFC_TRUSTED_PROXY_HOPS=1
# Nur setzen, wenn die App von einer anderen Domain auf die API zugreift:
# CORS_ORIGIN=https://deine-domain.example
PUBLIC_APP_URL=https://deine-domain.example
# Abrufrhythmus in Minuten
AFC_OBS_MIN=10
AFC_FORECAST_MIN=30
AFC_FETCH_TIMEOUT_MS=20000
